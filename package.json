{
    "name": "phirepass-widgets",
    "version": "0.0.113",
    "description": "Phirepass widgets for the web application",
    "main": "dist/index.cjs.js",
    "module": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "collection": "dist/collection/collection-manifest.json",
    "collection:main": "dist/collection/index.js",
    "unpkg": "dist/phirepass-widgets/phirepass-widgets.esm.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/phirepass-widgets/phirepass-widgets.esm.js",
            "require": "./dist/phirepass-widgets/phirepass-widgets.cjs.js"
        },
        "./my-component": {
            "types": "./dist/components/my-component.d.ts",
            "import": "./dist/components/my-component.js"
        },
        "./loader": {
            "types": "./loader/index.d.ts",
            "import": "./loader/index.js",
            "require": "./loader/index.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/phirepass/phirepass-widgets"
    },
    "files": [
        "dist/",
        "loader/",
        "LICENSE"
    ],
    "scripts": {
        "build": "stencil build",
        "build:prod": "stencil build --prod",
        "start": "stencil build --dev --watch --serve",
        "test": "vitest run --config vitest.config.mts --project spec",
        "test.watch": "vitest --config vitest.config.mts --project spec",
        "test:storybook": "stencil build && vitest run --config vitest.config.mts --project storybook",
        "test:all": "npm run test && npm run test:storybook",
        "storybook": "stencil build && storybook dev -p 6006",
        "build-storybook": "stencil build && storybook build",
        "generate": "stencil generate"
    },
    "devDependencies": {
        "@stencil/core": "^4.45.3",
        "@stencil/vitest": "^1.16.2",
        "@storybook/addon-a11y": "^10.6.7",
        "@storybook/addon-docs": "^10.6.7",
        "@storybook/addon-vitest": "^10.6.7",
        "@storybook/web-components-vite": "^10.6.7",
        "@types/node": "^26.6.6",
        "@vitest/browser": "^5.1.0",
        "@vitest/browser-playwright": "^5.1.0",
        "lit": "^3.3.3",
        "playwright": "^1.65.1",
        "storybook": "^10.6.7",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "license": "AGPL-3.0-or-later",
    "dependencies": {
        "@devolutions/iron-remote-desktop": "^0.11.0",
        "@devolutions/iron-remote-desktop-rdp": "^0.7.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-image": "^0.9.0",
        "@xterm/addon-search": "^0.16.0",
        "@xterm/addon-serialize": "^0.14.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/xterm": "^6.0.0",
        "phirepass-channel": "^0.1.356"
    }
}
